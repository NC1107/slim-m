# slim-m server configuration (SLIMM_-prefixed environment variables).
# Copy to .env for local development.

# TCP port for the HTTP and WebSocket surface.
SLIMM_PORT=8080

# Path to the embedded SQLite database file.
SLIMM_DATABASE_PATH=data/slimm.db

# Directory attachment and avatar bytes are stored under, beside the database
# rather than in it. NOT covered by the Litestream backup example in
# deploy/ - that streams only the SQLite file. See deploy/README.md.
SLIMM_ATTACHMENTS_DIR=data/media

# Largest attachment a single upload may store, in bytes.
SLIMM_ATTACHMENT_MAX_BYTES=10485760

# Log filter (tracing EnvFilter syntax), for example: info, debug, slimm_server=debug.
SLIMM_LOG=info
