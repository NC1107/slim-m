# Named for the GTK application id set in client/packages/app/linux/CMakeLists.txt.
# Wayland matches a window to its launcher entry by that id, so the two must agree.
[Desktop Entry]
Type=Application
Name=slim-m
GenericName=Messaging
Comment=Chat, voice, and screen share on a slim-m server
# %u hands a tapped slimm:// invite link to the app; MimeType below is what routes the scheme here.
Exec=slim-m %u
MimeType=x-scheme-handler/slimm;
# Names the hicolor icons the spec installs, which are keyed on the application
# id rather than a filename. Renaming this without renaming those breaks both.
Icon=top.npcserver.slimm
Terminal=false
StartupNotify=true
StartupWMClass=top.npcserver.slimm
Categories=Network;InstantMessaging;
Keywords=chat;messaging;voice;
