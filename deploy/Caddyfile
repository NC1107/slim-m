# Production Caddyfile for the slim-m self-host example.
#
# Caddy is the only thing bound to port 443 in this stack. It terminates TLS
# for the slim-m API domain, obtaining and renewing a Let's Encrypt
# certificate automatically.
#
# Voice is not here. LiveKit's signaling site lives in deploy/caddy-voice/,
# mounted at /etc/caddy/conf.d only by docker-compose.voice.yml, and picked up
# by the import at the bottom of this file. A text-only deployment never
# mounts that directory, the glob matches nothing, and Caddy is content with
# that - an import matching no files is valid, not an error.
#
# {$VAR} is Caddy's own environment-variable syntax, resolved from the
# `environment:` block of the `caddy` service in docker-compose.yml (which is
# in turn filled in from your `.env`). That is a separate substitution pass
# from docker compose's own ${VAR} handling elsewhere in this repo.

{
	email {$ACME_EMAIL}
}

# The slim-m server: REST API plus its WebSocket event stream.
{$SLIMM_API_DOMAIN} {
	reverse_proxy server:8080
}

# Voice, when docker-compose.voice.yml is in play. Matches nothing otherwise.
import /etc/caddy/conf.d/*.caddy
