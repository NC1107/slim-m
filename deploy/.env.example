# Production self-host configuration for slim-m.
#
# Copy this file to the repository root as `.env` (next to docker-compose.yml)
# so `docker compose` picks it up automatically:
#   cp deploy/.env.example .env
# then fill in the values below before `docker compose up -d`.

# -----------------------------------------------------------------------
# Domains and TLS
# -----------------------------------------------------------------------

# Public domain the slim-m API is served on. Caddy requests and renews a
# Let's Encrypt certificate for this domain automatically; point an A/AAAA
# record at this host before you start the stack.
SLIMM_API_DOMAIN=slimm.example.com

# Public domain LiveKit's WebSocket signaling is served on. Needs its own
# A/AAAA record too. Call media (TURN/UDP) does not use this domain's
# certificate - see docker-compose.yml and deploy/Caddyfile.
LIVEKIT_DOMAIN=livekit.example.com

# Email Caddy registers with Let's Encrypt for expiry notices.
ACME_EMAIL=admin@example.com

# -----------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------

# Log filter (tracing EnvFilter syntax), for example: info, debug, slimm_server=debug.
SLIMM_LOG=info

# Browser origins allowed to call this server cross-origin, comma separated,
# for example: https://app.example.com,http://localhost:8099
#
# Leave it empty unless you serve a web build of the client from a different
# origin than the API. Empty means no CORS layer at all, and every
# cross-origin browser request is refused. Desktop and mobile clients send no
# Origin header, so none of this affects them.
#
# Deny-by-default is deliberate, and it is not only about a public server. A
# self-host usually sits on a network your browser can route to and the
# internet cannot; an open policy would hand every page you visit the ability
# to drive it from inside that perimeter, which is exactly what its network
# position was protecting it from. "*" is refused outright at startup for the
# same reason, as is a malformed entry: an origin is scheme://host[:port] with
# no trailing path, so the server names the bad value and stops rather than
# letting you find it in a browser console later.
#
# Credentials are never allowed regardless of what you set here. slim-m
# authenticates with an Authorization: Bearer header the client attaches
# itself, never a cookie, so there is nothing for credentialed mode to buy.
SLIMM_CORS_ALLOWED_ORIGINS=

# How many reverse proxies you run in front of the server, for rate limiting.
#
# 1 is correct for this stack: Caddy is the one proxy. Add one per extra hop -
# a CDN in front of Caddy makes it 2.
#
# Leave this at 0 (or unset) only if the server is exposed directly, and do not
# guess. Too low puts every unauthenticated caller in one bucket, so one of
# them can hold the login budget empty for everybody. Too high reads an address
# the client chose, and the limit stops existing. deploy/README.md explains why
# the header is read from the right, which is what makes a correct value safe.
SLIMM_TRUST_PROXY_HOPS=1

# Most bytes this deployment will hold in attachments and custom emoji, or
# empty for no ceiling.
#
# 2 GiB here, which suits the small self-hosts this is built for. Set it from
# the volume you actually gave the stack, leaving room for the database.
#
# Avatars are outside it deliberately: one file per account, overwritten in
# place, so their total is already bounded by your member count.
#
# Past the ceiling an upload is refused with 507, which is a different answer
# from the 413 an over-large single file gets - so a screenshot tells you
# whether the fix is yours or the sender's. Note that Litestream replicates
# the database only, never these bytes; deploy/README.md says so.
SLIMM_MAX_TOTAL_ATTACHMENT_BYTES=2147483648

# GIF search, proxied through this server so a member's own IP address and
# search terms never reach the provider directly - the client only ever talks
# to this deployment.
#
# Both empty (the default) means no GIF search at all: no button in the
# client, and the three proxy routes answer 501. Set both to enable it.
# SLIMM_GIF_PROVIDER is "tenor" or "klipy", case-insensitively; an
# unrecognized value fails the server at startup rather than silently
# disabling the feature. SLIMM_GIF_API_KEY is your own key from whichever
# provider you chose - Tenor's is free from Google's API console, Klipy's
# from klipy.com.
SLIMM_GIF_PROVIDER=
SLIMM_GIF_API_KEY=

# -----------------------------------------------------------------------
# LiveKit (voice and screen share)
# -----------------------------------------------------------------------

# API key/secret pair LiveKit issues access tokens against. These authorize
# minting a room token, so anyone holding them can join any room on this
# server: generate your own and never ship the values below.
#
#   docker run --rm livekit/livekit-server:v1.10.1 generate-keys
#
# Left deliberately empty rather than filled with a placeholder. The compose
# file requires both, so an unset value stops the stack with a message naming
# the variable instead of quietly starting an SFU with a known key.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# UDP port range LiveKit's media relay uses for calls. Allow this exact
# range through your router or cloud firewall, in addition to Docker
# publishing it (see docker-compose.yml). One port per published track, so a
# friend group needs nowhere near a hundred; the range is kept small on
# purpose, because every published port is another iptables rule and another
# userland proxy at container start.
LIVEKIT_UDP_PORT_START=50000
LIVEKIT_UDP_PORT_END=50100

# TURN's relay ports, a separate block from the media range above. Must be
# allowed through the same firewall. Leaving them closed does not disable
# TURN, it makes it advertise relay candidates that always time out.
LIVEKIT_TURN_RELAY_PORT_START=30000
LIVEKIT_TURN_RELAY_PORT_END=30100

# TCP fallback and STUN/TURN ports. Move them if something else on the host
# already holds one - a UniFi controller, for instance, publishes 3478 for its
# own STUN, and a second SFU would already hold 7881. Both sides of each
# mapping follow this value, so changing it here is enough.
LIVEKIT_TCP_PORT=7881
LIVEKIT_TURN_UDP_PORT=3478

# -----------------------------------------------------------------------
# Litestream backups (disabled by default)
# -----------------------------------------------------------------------
# The litestream sidecar continuously streams the server's SQLite WAL to
# S3-compatible object storage. It is off by default because it needs real
# bucket credentials. To enable it: fill in the LITESTREAM_* values below
# with a bucket that already exists, then uncomment COMPOSE_PROFILES.

# COMPOSE_PROFILES=litestream

# Access key pair for your S3-compatible bucket. Litestream reads these two
# exact variable names natively - no other wiring is needed.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Bucket and prefix the database is streamed to.
LITESTREAM_S3_BUCKET=
LITESTREAM_S3_PATH=slimm

# Endpoint and region of your S3-compatible provider, for example
# Backblaze B2 (s3.us-west-000.backblazeb2.com, us-west-000), Cloudflare R2
# (<account id>.r2.cloudflarestorage.com, auto), or MinIO (your host:port,
# any region string). Leave both blank only if you are replicating to real
# AWS S3.
LITESTREAM_S3_ENDPOINT=
LITESTREAM_S3_REGION=auto
