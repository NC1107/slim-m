@@ -353,6 +353,12 @@ void FlutterScreenCapture::GetDisplayMedia(
 
   base_->local_streams_[uuid] = stream;
 
+  // Mirrors the camera path's video_capturers_ entry: without it, dispose
+  // only drops references and never asks the desktop capturer to stop
+  // explicitly, leaving the OS-level capture session alive until C++
+  // refcounting happens to reach zero on its own.
+  base_->desktop_capturers_[track->id().std_string()] = desktop_capturer;
+
   desktop_capturer->Start(uint32_t(fps));
 
