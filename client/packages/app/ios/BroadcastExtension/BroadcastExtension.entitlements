<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match Runner/Runner.entitlements and RTCAppGroupIdentifier in
	     Runner/Info.plist. A mismatch is silent: the broadcast starts and
	     then delivers no frames. The hygiene workflow gates all three. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.top.npcserver.slimm</string>
	</array>
</dict>
</plist>
