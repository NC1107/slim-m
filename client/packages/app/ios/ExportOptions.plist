<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store</string>
	<!-- Manual signing, because the CI runner has no Apple account session to
	     resolve a profile automatically; the profile below is imported from a
	     secret before the build. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>teamID</key>
	<string>76S78SUWVM</string>
	<!-- Every embedded bundle needs its own entry under manual signing, and
	     both extensions are separate bundles with their own ids. Each profile
	     has to exist in the portal and be installed on the runner alongside
	     the app's, or the export fails naming that id. -->
	<key>provisioningProfiles</key>
	<dict>
		<key>top.npcserver.slimm</key>
		<string>slim-m App Store Distribution</string>
		<key>top.npcserver.slimm.BroadcastExtension</key>
		<string>slim-m Broadcast Extension App Store</string>
		<key>top.npcserver.slimm.NotificationService</key>
		<string>slim-m Notification Service App Store</string>
	</dict>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
