<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- The broadcast upload extension is a separate process; this shared
	     container is the only place the two can meet. flutter_webrtc opens
	     the capture socket in it, the extension connects to it. Must match
	     BroadcastExtension/BroadcastExtension.entitlements exactly. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.top.npcserver.slimm</string>
	</array>
	<!-- The first entry is this app's own default group, named explicitly so
	     it stays the default: declaring this key at all makes the first entry
	     where an item with no group of its own is written, and every secret
	     this app already stored is sitting in that group. The second is the
	     push key's own group, which NotificationService also claims and
	     nothing else does. No portal capability: both profiles already carry
	     the team-wide 76S78SUWVM.* wildcard. -->
	<key>keychain-access-groups</key>
	<array>
		<string>76S78SUWVM.top.npcserver.slimm</string>
		<string>76S78SUWVM.top.npcserver.slimm.push</string>
	</array>
</dict>
</plist>
