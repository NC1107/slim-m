<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon, used from API 26 up; the mipmap-*/ic_launcher.png
     bitmaps stay for the API levels below that, which cannot mask one. -->
<!-- The background is a flat colour rather than a bitmap because it is one:
     surfaceBase, edge to edge, so there is nothing for a layer to draw. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
