// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. Left at the generator's own value: the built
// product's filename and RunnerTests' TEST_HOST both hardcode "slimm_app"
// elsewhere in this project, and Info.plist's CFBundleDisplayName below is
// what a user actually sees, not this internal build product name.
PRODUCT_NAME = slimm_app

// The application's bundle identifier - matches ios/android's top.npcserver.slimm.
PRODUCT_BUNDLE_IDENTIFIER = top.npcserver.slimm

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 top.npcserver. All rights reserved.
